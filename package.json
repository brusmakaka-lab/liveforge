{
  "name": "liveforge",
  "version": "0.2.0",
  "private": true,
  "description": "Motor local de interacciones LIVE para videojuegos",
  "author": "Personal project",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.overlay.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dist:win": "npm run check && electron-builder --win nsis portable --x64",
    "test:packaged": "playwright test tests/e2e/packaged.spec.ts",
    "pack:win": "npm run build && electron-builder --win --dir --x64",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "rcon-client": "4.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tiktok-live-connector": "2.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "local.liveforge.desktop",
    "productName": "LiveForge",
    "directories": {
      "output": "release/v0.2.0"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LiveForge-Portable-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "artifactName": "LiveForge-Setup-${version}-x64.exe"
    }
  }
}
